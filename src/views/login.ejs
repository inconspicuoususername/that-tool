<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login</title>
  <style>
    :root { font-family: "Segoe UI", system-ui, -apple-system, sans-serif; background: #0c1116; color: #e6edf3; }
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; }
    .card { width: 320px; background: #0f1621; border: 1px solid #1f2a34; border-radius: 12px; padding: 20px; box-shadow: 0 8px 24px rgba(0,0,0,0.4); }
    h1 { margin: 0 0 12px; font-size: 20px; }
    label { display: block; margin: 12px 0 6px; font-size: 13px; color: #9fb3c8; }
    input { width: 100%; padding: 10px; border-radius: 10px; border: 1px solid #1f2a34; background: #111924; color: #e6edf3; }
    button { width: 100%; margin-top: 14px; padding: 10px; border: 1px solid #315dff; border-radius: 10px; background: #3a7cff; color: #fff; font-weight: 600; cursor: pointer; }
    button:hover { background: #315dff; }
    .error { color: #ff9da7; font-size: 12px; min-height: 16px; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Sign in</h1>
    <p style="color:#9fb3c8; margin:0 0 12px;">Authenticate with your GitHub-based JWT.</p>
    <div class="error" id="error"></div>
    <label for="token">JWT</label>
    <input id="token" name="token" type="text" placeholder="Paste JWT" />
    <button id="login">Continue</button>
  </div>

  <script type="module">
    const btn = document.getElementById("login");
    const tokenInput = document.getElementById("token");
    const errorEl = document.getElementById("error");

    btn.onclick = async () => {
      const token = tokenInput.value.trim();
      if (!token) {
        errorEl.textContent = "Token is required.";
        return;
      }
      // Store token in localStorage for fetches and as query param fallback
      localStorage.setItem("jwt", token);
      // Redirect to monitor with token in query to pass guard
      window.location.href = `/monitor?token=${encodeURIComponent(token)}`;
    };

    // If already have a token, try redirect immediately
    const existing = localStorage.getItem("jwt");
    if (existing) {
      window.location.href = `/monitor?token=${encodeURIComponent(existing)}`;
    }
  </script>
</body>
</html>
