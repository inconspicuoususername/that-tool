<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Agent Monitor</title>
  <style>
    :root {
      font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
      background: #0c1116;
      color: #e6edf3;
    }
    body { margin: 0; padding: 0; }
    header { padding: 16px 20px; border-bottom: 1px solid #1f2a34; display: flex; justify-content: space-between; align-items: center; }
    h1 { margin: 0; font-size: 18px; letter-spacing: 0.3px; }
    main { padding: 16px 20px; display: grid; gap: 16px; grid-template-columns: 280px 1fr; align-items: start; }
    section { background: #0f1621; border: 1px solid #1f2a34; border-radius: 10px; padding: 12px 14px; box-shadow: 0 6px 20px rgba(0,0,0,0.35); }
    section h2 { margin: 0 0 8px 0; font-size: 14px; font-weight: 600; color: #8fb7ff; letter-spacing: 0.2px; }
    select, button { width: 100%; padding: 8px; margin: 6px 0; border-radius: 8px; border: 1px solid #1f2a34; background: #111924; color: #e6edf3; }
    button { cursor: pointer; transition: background 0.15s ease; }
    button:hover { background: #162033; }
    .list { display: flex; flex-direction: column; gap: 6px; max-height: 380px; overflow: auto; }
    .item { border: 1px solid #1f2a34; border-radius: 8px; padding: 8px 10px; background: #111924; cursor: pointer; }
    .item small { color: #9fb3c8; display: block; margin-top: 2px; }
    .split { display: grid; gap: 10px; grid-template-columns: 1fr 1fr; }
    .logs { background: #0b1016; border: 1px solid #1f2a34; border-radius: 8px; padding: 10px; min-height: 200px; max-height: 320px; overflow: auto; font-family: "SFMono-Regular", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; font-size: 12px; white-space: pre-wrap; }
    .pill { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 11px; margin-left: 6px; }
    .status-running { background: #12374f; color: #7bd7ff; }
    .status-pending { background: #2a2736; color: #c3b5ff; }
    .status-complete { background: #143824; color: #70e0a2; }
    .status-error { background: #3b1c1f; color: #ff9da7; }
  </style>
</head>
<body>
  <header>
    <h1>Agent Monitor</h1>
    <button id="refresh">Refresh</button>
  </header>
  <main>
    <section>
      <h2>Projects</h2>
      <div class="list" id="projects"></div>
    </section>
    <section>
      <h2>Tasks & Subtasks</h2>
      <div class="split">
        <div>
          <strong>Tasks</strong>
          <div class="list" id="tasks"></div>
        </div>
        <div>
          <strong>Subtasks</strong>
          <div class="list" id="subtasks"></div>
        </div>
      </div>
      <div style="margin-top: 12px;">
        <strong>Logs</strong>
        <div class="logs" id="logs">Select a running subtask to view logs.</div>
      </div>
    </section>
  </main>
  <script type="module">
    const projectsEl = document.getElementById("projects");
    const tasksEl = document.getElementById("tasks");
    const subtasksEl = document.getElementById("subtasks");
    const logsEl = document.getElementById("logs");
    const refreshBtn = document.getElementById("refresh");

    let selectedProject = null;
    let selectedTask = null;
    let selectedSubtask = null;
    let eventSource = null;

    function statusPill(status) {
      const cls = {
        running: "status-running",
        pending: "status-pending",
        complete: "status-complete",
        error: "status-error",
      }[status] ?? "status-pending";
      return `<span class="pill ${cls}">${status}</span>`;
    }

    function clearLogs() {
      if (eventSource) {
        eventSource.close();
        eventSource = null;
      }
      logsEl.textContent = "Select a running subtask to view logs.";
    }

    function authHeaders() {
      const token = localStorage.getItem("jwt");
      return token ? { Authorization: `Bearer ${token}` } : {};
    }

    async function fetchJSON(url) {
      const res = await fetch(url, { headers: authHeaders() });
      if (!res.ok) throw new Error(`Request failed: ${res.status}`);
      return res.json();
    }

    async function loadProjects() {
      const data = await fetchJSON("/task/projects");
      projectsEl.innerHTML = "";
      data.projects?.forEach((p) => {
        const div = document.createElement("div");
        div.className = "item";
        div.innerHTML = `<strong>${p.projectName}</strong><small>${p.owner}/${p.repo}</small>`;
        div.onclick = () => {
          selectedProject = p;
          selectedTask = null;
          selectedSubtask = null;
          clearLogs();
          highlight(projectsEl, div);
          loadTasks();
          loadSubtasks();
        };
        projectsEl.appendChild(div);
      });
    }

    async function loadTasks() {
      tasksEl.innerHTML = selectedProject ? "" : "Select a project";
      if (!selectedProject) return;
      const data = await fetchJSON(`/task/projects/${selectedProject.id}/tasks`);
      tasksEl.innerHTML = "";
      data.tasks?.forEach((row) => {
        const t = row.task;
        const div = document.createElement("div");
        div.className = "item";
        div.innerHTML = `<strong>#${t.id}</strong> ${statusPill(t.status)}<small>${t.type}</small>`;
        div.onclick = () => {
          selectedTask = t;
          selectedSubtask = null;
          clearLogs();
          highlight(tasksEl, div);
          loadSubtasks();
        };
        tasksEl.appendChild(div);
      });
    }

    async function loadSubtasks() {
      subtasksEl.innerHTML = selectedProject ? "" : "Select a project";
      if (!selectedProject) return;
      const data = await fetchJSON(`/task/projects/${selectedProject.id}/subtasks`);
      subtasksEl.innerHTML = "";
      data.subtasks?.forEach((row) => {
        const s = row.subtask;
        const div = document.createElement("div");
        div.className = "item";
        div.innerHTML = `<strong>Subtask #${s.id}</strong> ${statusPill(s.status)}<small>Task #${s.taskId}</small>`;
        div.onclick = () => {
          selectedSubtask = s;
          highlight(subtasksEl, div);
          if (s.status === "running" || s.status === "pending") {
            startLogs(selectedTask ?? { id: s.taskId }, s.id);
          } else {
            clearLogs();
            logsEl.textContent = "Logs available only for running/pending subtasks.";
          }
        };
        subtasksEl.appendChild(div);
      });
    }

    function highlight(container, el) {
      Array.from(container.children).forEach((c) => c.style.outline = "none");
      el.style.outline = "2px solid #3a7cff";
    }

    function startLogs(task, subtaskId) {
      clearLogs();
      const url = new URL(`/task/${task.id}/logs/stream`, window.location.origin);
      url.searchParams.set("subtaskId", subtaskId);
      const token = localStorage.getItem("jwt");
      if (token) {
        url.searchParams.set("token", token);
      }
      eventSource = new EventSource(url);
      logsEl.textContent = "";
      eventSource.onmessage = (ev) => {
        const data = JSON.parse(ev.data);
        logsEl.textContent = data.logs ?? "";
        logsEl.scrollTop = logsEl.scrollHeight;
      };
      eventSource.onerror = () => {
        logsEl.textContent = "Log stream ended or unavailable.";
        eventSource.close();
      };
    }

    refreshBtn.onclick = () => {
      clearLogs();
      loadProjects().then(() => {
        tasksEl.innerHTML = "";
        subtasksEl.innerHTML = "";
      });
    };

    loadProjects();
  </script>
</body>
</html>
